# Turso / libSQL connection. Copy to .env.local and fill in real values.
# .env.local is gitignored -- never commit a real auth token.
#
# Local dev (SQLite file, no credentials needed):
#   TURSO_DATABASE_URL="file:local.db"
#   TURSO_AUTH_TOKEN=""
#
# Hosted Turso (production):
#   TURSO_DATABASE_URL="libsql://your-db-xxxx.aws-eu-west-1.turso.io"
#   TURSO_AUTH_TOKEN="eyJhbGciOiJFZERTQSIsInR5..."

TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Shared secret for the admin panel. Any long random string. Also gitignored.
ADMIN_PASSWORD=""