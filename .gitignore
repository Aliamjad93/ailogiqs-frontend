node_modules
dist
.DS_Store
*.log

# Next.js build output
.next
out

# Local environment files. These hold the Turso/libSQL auth token -- they must
# never be committed. .env.example is the committed template.
.env
.env.local
.env*.local

# Turso CLI
.turso

# Local dev tooling: db setup/seed, Puppeteer smoke tests and layout audits.
# Untracked, so it never reaches the repo. Note that package.json's test:* and
# db:* entries expect these -- a fresh clone will not have them.
scripts/

tmp
.vercel

# Reference material and local-only folders. None of it is needed to build or run
# the app: the artwork that is actually served lives in public/assets/img/custom/
# (and public/assets/img/hero/), and these are just the original sources and the
# WorkBuddy workspace metadata.
pdf images/
custom images/
.workbuddy-ai/
