node_modules
dist
.DS_Store
*.log

# Next.js build output
.next
out

# Local environment files. These hold the Turso/libSQL auth token -- they must
# never be committed. .env.example is the committed template.
.env
.env.local
.env*.local

# Turso CLI
.turso

# Local dev tooling: db setup/seed, Puppeteer smoke tests and layout audits.
# Untracked, so it never reaches the repo. Note that package.json's test:* and
# db:* entries expect these -- a fresh clone will not have them.
scripts/

tmp
.vercel

# Reference material and local-only folders. None of it is needed to build or run
# the app: the artwork that is actually served lives in public/assets/img/custom/
# (and public/assets/img/hero/), the video in public/assets/video/, and these are
# just the original sources and the WorkBuddy workspace metadata.
#
# The root video is the 12 MB master, not the copy the homepage loads. Ignore it
# by name rather than by extension: public/assets/video/*.mp4 is served, so a
# blanket `*.mp4` would exclude the file the site actually needs.
/home-chatbot-video.mp4

# The Photoroom export the agent chat mockup was cut from, before it was
# downscaled and converted to public/assets/img/custom/agent-chat.webp.
/image_*-Photoroom.png
pdf images/
custom images/
.workbuddy-ai/

# Root-level working files from the service-page builds: the BeeLens source
# deck and its cut-out PNGs, scratch exports and a stray installer. Reference
# material only -- none of it builds or runs the site.
/Bee Virus Detection Infographic.html
/Bee Virus Detection Infographic.pdf
/_e.html
/bee_diagnosis_transparent.png
/bee_hive_transparent.png
/wow.png
/Pikkio-Setup-*.exe

# Playwright MCP's session logs, written during the layout audits.
/.playwright-mcp/

# Source material for the /portfolio page: the WhatsApp screenshots and the
# portfolio.txt.txt notes the case studies were written from. The served images
# live in public/assets/img/projects/ -- this folder is only the source.
portfolio-content/
